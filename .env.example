# ─────────────────────────────────────────────────────────────────────────────
# DiffSense AI — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub App (required) ─────────────────────────────────────────────────────
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Private key — pick ONE of these two options:
# Option A: file path (local development)
GITHUB_APP_PRIVATE_KEY_PATH=./your-app.private-key.pem
# Option B: raw PEM content with literal \n (Railway / Render / cloud deployments)
# GITHUB_APP_PRIVATE_KEY_CONTENTS=-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
ENV=production

# ── AI Provider (server default) ──────────────────────────────────────────────
# The server-wide default provider used for free-tier reviews.
# Each GitHub App installation can override this with their own key via /setup.
#
# Options: groq | openai | claude | gemini | grok | local
AI_PROVIDER=groq

# ── Groq (recommended default — fast inference, free tier) ────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Anthropic Claude (optional) ───────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Google Gemini (optional) ──────────────────────────────────────────────────
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# ── xAI Grok (optional) ───────────────────────────────────────────────────────
# GROK_API_KEY=xai-...
# GROK_MODEL=grok-3-mini

# ── Local LLM — llama.cpp (dev only) ──────────────────────────────────────────
# Only used when AI_PROVIDER=local. Run: make llm
# Native (`make run`): http://localhost:8080
# Docker (`make up`) overrides this to http://host.docker.internal:8080
# LOCAL_LLM_URL=http://localhost:8080
# LOCAL_LLM_MODEL=qwen2.5-coder

# ── Multi-tenant Configuration (required for /setup page + usage tracking) ────
# Without DATABASE_URL, the app works but all installations share the server
# default provider, free-tier tracking is disabled, and every push re-reviews
# the full PR (no last-SHA / duplicate-comment memory).

# PostgreSQL connection string (Railway auto-sets this when you add Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# AES-256-GCM key for encrypting user API keys at rest.
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Free reviews per installation before they must add their own API key
# FREE_REVIEWS_LIMIT=100

# ── Worker Pool ───────────────────────────────────────────────────────────────
WORKER_COUNT=5
MAX_FILES_PER_PR=50
MAX_PATCH_CHARS=10000

# ── AI Settings ───────────────────────────────────────────────────────────────
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=120
