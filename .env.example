# ============================================================
# GitHub App credentials
# ============================================================
GITHUB_APP_ID=123456

# Option A — file path to the .pem private key
GITHUB_APP_PRIVATE_KEY_PATH=/etc/secrets/private-key.pem

# Option B — raw PEM content (for Railway / Render / Docker env vars)
# Replace actual newlines with literal \n when pasting
# GITHUB_APP_PRIVATE_KEY_CONTENTS=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----

GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================
# AI Provider — choose one of: local | openai | claude | gemini | grok
# ============================================================
AI_PROVIDER=local

# --- Local LLM (llama.cpp server) — used when AI_PROVIDER=local ---
LOCAL_LLM_URL=http://localhost:8080
LOCAL_LLM_MODEL=qwen2.5-coder

# --- OpenAI — used when AI_PROVIDER=openai ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Anthropic Claude — used when AI_PROVIDER=claude ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Google Gemini — used when AI_PROVIDER=gemini ---
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# --- xAI Grok — used when AI_PROVIDER=grok ---
# GROK_API_KEY=xai-...
# GROK_MODEL=grok-3-mini

# ============================================================
# Shared AI settings
# ============================================================
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=120

# ============================================================
# Server
# ============================================================
PORT=3000
ENV=development

# ============================================================
# Worker pool
# ============================================================
WORKER_COUNT=5
MAX_FILES_PER_PR=50
MAX_PATCH_CHARS=10000
